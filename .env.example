ADMIN_PASSWORD=nest5admin
SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///./nest5.db

# ADMIN_PASSWORD is only used once: on first startup it becomes the password of the
# `admin` login. After that, change it in the app (Change password) — editing this
# value later does not change the admin password. Lost it? Use "Forgot password →
# Send admin recovery link" on the login page, or run: python scripts/reset_admin.py

# ---- Password reset / recovery email -------------------------------------------
# Admin recovery links always go here.
ADMIN_RECOVERY_EMAIL=vveerava@gmail.com
# Optional: public address used inside emailed links (default: the URL you opened).
# APP_BASE_URL=http://127.0.0.1:8000
# RESET_TOKEN_TTL_MINUTES=60

# SMTP. Leave SMTP_HOST empty to skip email: reset links are then printed in the
# terminal running the app and appended to instance/outbox.log.
#
# Gmail how-to (needs 2-Step Verification on the Google account):
#   1. Open https://myaccount.google.com/apppasswords
#   2. Create an app password named "Nest5 ledger"; Google shows 16 letters.
#   3. Fill in below: SMTP_USER = the Gmail address, SMTP_PASSWORD = the 16 letters
#      (spaces optional), SMTP_FROM = the same Gmail address.
#   4. Restart ./run-local.sh, then test with "Forgot password?" on the login page.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Gmail example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=yourname@gmail.com
# SMTP_PASSWORD=abcd efgh ijkl mnop
# SMTP_FROM=yourname@gmail.com

# ---- Local folders (relative to nest5-ledger/) -----------------------------------
# INSTANCE_DIR=instance      # outbox.log, initial-passwords.txt
# BACKUP_DIR=backups         # automatic SQLite copies
# BACKUP_KEEP=30

# ---- UPI "Pay now" sheet (v7, reworked in v8) -------------------------------------
# The Pay now sheet shows this UPI ID, the mobile number and the amount with Copy buttons,
# a QR code and an "Open PhonePe" launch-only button (PhonePe declines prefilled pay links to a
# personal UPI ID). UPI does not tell the portal that a payment happened: the owner still enters the UPI reference (UTR, required for UPI)
# and submits, and the admin reviews it as usual.
UPI_VPA=9940255076@ybl
UPI_PAYEE_NAME=Sri Krishna Mani Flats
UPI_MOBILE=9940255076
